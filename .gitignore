# Ignore all
*

# Unignore all with specific extensions
!*.txt
!*.log
!*.cpp
!*.cu
!*.h
!*.hpp
!*.inc

# and this file
!.gitignore

# Unignore all dirs
!*/

# Really ignore build and bin directories
build/
build-*/
build_*/
cmake-build-*/
bin/
CMakeFiles/

# Ignore generated repository metadata, including preserved agent-created histories.
.git/
.git.agent-backup/
.hg/
.svn/

# Ignore CMake cache files
CMakeCache.txt
CMakeCache_backup.txt
